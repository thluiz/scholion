#!/bin/sh
# Pre-push hook: regenerate git history JSONs and commit them so they ship on
# the next push. The current push is already resolved; new JSONs do not make it
# into this push, but the commit stays on the local branch for the next push.
# Copy to .git/hooks/pre-push:
#   cp scripts/pre-push .git/hooks/pre-push
#   chmod +x .git/hooks/pre-push

PYTHON=$(command -v py || command -v python || command -v python3)
"$PYTHON" scripts/gen_git_history.py --all

if ! git diff --quiet -- data/git_history/; then
    git add data/git_history/
    git commit --no-verify -m "chore: update git history"
fi
