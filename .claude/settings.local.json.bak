      "Bash(PYTHONIOENCODING=utf-8 python -X utf8 -c \"\nimport asyncio\nfrom playwright.async_api import async_playwright\n\nasync def fetch\\(char\\):\n    async with async_playwright\\(\\) as p:\n        browser = await p.chromium.launch\\(\\)\n        page = await browser.new_page\\(\\)\n        try:\n            await page.goto\\(f'https://hanziyuan.net/#{char}', wait_until='domcontentloaded', timeout=30000\\)\n            await page.wait_for_timeout\\(5000\\)\n            text = await page.inner_text\\('body'\\)\n        except:\n            text = 'FETCH_FAILED'\n        await browser.close\\(\\)\n        return text\n\nchars = ['\\\\u5229', '\\\\u738B', '\\\\u6CD5']\nfor c in chars:\n    result = asyncio.run\\(fetch\\(c\\)\\)\n    print\\(f'=== {c} ==='\\)\n    for line in result[:1500].split\\('\\\\n'\\):\n        line = line.strip\\(\\)\n        if any\\(k in line for k in ['Found', 'Original meaning', 'Shuowen', 'decomposition', 'Oracle', 'Bronze', 'Seal', 'from ', 'Compound']\\):\n            print\\(line\\)\n    print\\(\\)\n\" 2>&1)",
      "Bash(PYTHONIOENCODING=utf-8 python -X utf8 -c \"\nimport asyncio\nfrom playwright.async_api import async_playwright\n\nasync def fetch\\(char\\):\n    async with async_playwright\\(\\) as p:\n        browser = await p.chromium.launch\\(\\)\n        page = await browser.new_page\\(\\)\n        try:\n            await page.goto\\(f'https://hanziyuan.net/#{char}', wait_until='domcontentloaded', timeout=30000\\)\n            await page.wait_for_timeout\\(5000\\)\n            text = await page.inner_text\\('body'\\)\n        except:\n            text = 'FETCH_FAILED'\n        await browser.close\\(\\)\n        return text\n\nfor c in ['\\\\u5B89', '\\\\u901A']:\n    result = asyncio.run\\(fetch\\(c\\)\\)\n    print\\(f'=== {c} ==='\\)\n    for line in result[:2000].split\\('\\\\n'\\):\n        line = line.strip\\(\\)\n        if any\\(k in line for k in ['Found', 'Original meaning', 'Shuowen', 'decomposition', 'Oracle', 'Bronze', 'Seal', 'from ', 'Compound', 'phonetic', 'Liushutong', 'no known']\\):\n            print\\(line\\)\n    print\\(\\)\n\" 2>&1)",
