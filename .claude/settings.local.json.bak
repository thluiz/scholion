      "Bash(PYTHONIOENCODING=utf-8 python -c \"\nimport asyncio\nfrom playwright.async_api import async_playwright\n\nasync def fetch_hanziyuan\\(char\\):\n    async with async_playwright\\(\\) as p:\n        browser = await p.chromium.launch\\(\\)\n        page = await browser.new_page\\(\\)\n        try:\n            await page.goto\\(f'https://hanziyuan.net/#{char}', wait_until='networkidle', timeout=15000\\)\n            await page.wait_for_timeout\\(3000\\)\n            text = await page.inner_text\\('body'\\)\n            await browser.close\\(\\)\n            return text\n        except Exception as e:\n            await browser.close\\(\\)\n            return f'Error: {e}'\n\nasync def main\\(\\):\n    for char in ['\\\\u61c3', '\\\\u99ac']:\n        print\\(f'\\\\n=== {char} ==='\\)\n        result = await fetch_hanziyuan\\(char\\)\n        print\\(result[:3000]\\)\n\nasyncio.run\\(main\\(\\)\\)\n\")",
